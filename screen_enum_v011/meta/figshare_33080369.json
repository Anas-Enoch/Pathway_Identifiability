nload_url": "https://ndownloader.figshare.com/files/66970520", "supplied_md5": "7563d20a7a9b4bfad6cc6daf52947c10", "computed_md5": "7563d20a7a9b4bfad6cc6daf52947c10", "mimetype": "application/x-rar"}, {"id": 66970592, "name": "T2D_pos.rar", "size": 1733284091, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/66970592", "supplied_md5": "44aea86f4f29fe003b88456696dcdec5", "computed_md5": "44aea86f4f29fe003b88456696dcdec5", "mimetype": "application/x-rar"}, {"id": 66971330, "name": "DACD_pos.rar", "size": 1699706807, "is_link_only": false, "download_url": "https://ndownloader.figshare.com/files/66971330", "supplied_md5": "15db63f14ed48fe620990359ec9dcf23", "computed_md5": "15db63f14ed48fe620990359ec9dcf23", "mimetype": "application/x-rar"}], "folder_structure": {}, "authors": [{"id": 7547327, "full_name": "Hong Zheng", "first_name": "Hong", "last_name": "Zheng", "is_active": true, "url_name": "Hong_Zheng", "orcid_id": "0000-0002-3401-721X"}], "custom_fields": [], "figshare_url": "https://figshare.com/articles/dataset/Dataset_on_the_changes_in_the_gut_microbiome_and_serum_metabolome_in_type_2_diabetic_patients_with_cognitive_decline/33080369", "download_disabled": false, "description": "<p dir=\"ltr\">Dysbiosis of the gut microbiota and its metabolites contributes to the onset and progression of diabetes-associated cognitive decline (DACD) through the gut-brain axis. However, alterations in the gut microbiota and host metabolism in patients with DACD remain poorly characterized, and whether these changes contain biomarkers for predictive diagnosis is still unclear. Here we analyzed fecal microbiota and serum metabolomic profiles in healthy controls, patients with type 2 diabetes and DACD patients by using 16S rRNA sequencing and LC-MS-based metabolomics analyses, respectively.</p>", "funding": "Major Scientific and Technological Innovation Project of Wenzhou, China (No.: ZY2024027) and the Summit Advancement Disciplines of Zhejiang Province